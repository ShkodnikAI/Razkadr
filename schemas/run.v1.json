{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://razkadr.dev/schemas/run.v1.json",
  "title": "Razkadr run manifest",
  "description": "RunContext output (naryad 036): run metadata, stage log and provider call accounting. See docs/artifacts.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "razkadr_version",
    "config_hash",
    "stages",
    "provider_calls"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/schemaVersion"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Run identifier; equals the run directory name."
    },
    "created_utc": {
      "type": "string",
      "description": "Run start time, UTC; ISO 8601 (syntactic check: YYYY-MM-DDThh:mm:ss[.frac](Z|±hh:mm)).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "razkadr_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the razkadr package that produced the run."
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the effective run configuration; changes when presets/providers change."
    },
    "tool_versions": {
      "type": "object",
      "description": "Versions of external tools used by the run (ffmpeg, python, ...).",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "stages": {
      "type": "array",
      "description": "One entry per executed stage, in execution order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Stage name (ingest, frames, transcript, chunks, ocr, index, select, text, build)."
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "skipped",
              "cached"
            ]
          },
          "started_utc": {
            "type": "string",
            "description": "Stage start time, UTC; ISO 8601 (syntactic check: YYYY-MM-DDThh:mm:ss[.frac](Z|±hh:mm)).",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "duration_s": {
            "type": "number",
            "minimum": 0,
            "description": "Stage wall time, seconds."
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "description": "Failure reason; present when status is failed."
          }
        }
      }
    },
    "provider_calls": {
      "type": "array",
      "description": "Accounting of external API calls; empty for CPU-only runs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "provider",
          "model",
          "units",
          "cost",
          "cache_hit"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1,
            "description": "Pipeline stage that made the call."
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "description": "Provider id from the provider layer."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Model name as requested."
          },
          "task": {
            "type": "string",
            "enum": [
              "asr",
              "embed",
              "ocr",
              "vlm",
              "llm"
            ],
            "description": "Provider task type; useful when one provider serves several tasks."
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "description": "Billed or measured units of the call (seconds of audio, tokens, images).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "seconds",
                    "tokens",
                    "images"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "currency",
              "tariff_date"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "Cost of the call."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 code."
              },
              "tariff_date": {
                "type": "string",
                "description": "Date of the provider tariff; ISO 8601 calendar date (syntactic check).",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          },
          "cache_hit": {
            "type": "boolean",
            "description": "True when the result came from the call cache and no billable request was made."
          }
        }
      }
    }
  },
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Artifact schema version, semver (patch may be omitted)."
    }
  }
}
